    "version": "0.2.0",
    "configurations": [
        {
            "name": "C00003",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["-cfg", "core\\fc\\FlowControl.json", "-shid", "2", "-sbid", "C00003", "-pbid", "PCB5003001", "-ep", "20003", "-sip", "15.1.1.10"]
        },
        {
            "name": "C00004",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["-cfg", "core\\fc\\FlowControl.json", "-shid", "2", "-sbid", "C00004", "-pbid", "PCB5004001", "-ep", "20004", "-sip", "15.1.1.10"]
        },
        {
            "name": "Attach FC",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 30003
            },
            "justMyCode": true
        },
        {
            "name": "Debug CCMS",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/core/main/ccms.py",
            "console": "integratedTerminal",

            "subProcess": true
        },
        {
            "name": "Debug CCMS Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "discover",
                "-s",
                "tests",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Debug E2E CCMS Flow",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "tests.test_e2e_ccms_flow",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}